{
  "name": "aurel-restaurant",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "setup": "node scripts/setup.mjs",
    "build:lambda": "node scripts/build-lambda.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build:lambda",
    "test:smoke": "node scripts/smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.900.0",
    "@aws-sdk/client-dynamodb": "^3.900.0",
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/client-sesv2": "^3.900.0",
    "@aws-sdk/lib-dynamodb": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "jose": "^6.0.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
